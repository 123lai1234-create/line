# Copy to .env (gitignored) for local dev. DO NOT COMMIT.

# Postgres connection string. Get from Neon / Railway Postgres.
# Must include ?sslmode=require for Railway Postgres.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# LINE Messaging API
# Find both at https://developers.line.biz/console/ → your channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Admin panel login (use any string)
ADMIN_PASSWORD=

# Cookie HMAC signing (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=

# Required by index.ts; Railway sets automatically. Local dev: 8080.
PORT=8080
NODE_ENV=development
TZ=Asia/Taipei
LOG_LEVEL=debug
